// Quantum-style interfer pedagogy (shared coin paths) — not full DTQW.
// Prefer dtqw.qpex for H_coin ⊗ H_pos + apply/shift.
// Nested `when` is illegal (NESTED_WHEN_ERROR).

package examples.walk

pub fn main() -> Unit {
    state qcoin = coin()
    state left = when (qcoin) {
      0 -> -2,
      else -> 0,
    }
    state right = when (qcoin) {
      0 -> 0,
      else -> 2,
    }
    state quantum = interfer(left, right)
    state viewed = inspect(quantum)
    measure viewed
}
