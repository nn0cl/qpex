// True DTQW — typed H_coin ⊗ H_pos (ADR 0044)
// U_step = S (Coin ⊗ I), Coin = (X+Z)/√2 = Hadamard

package com.qpex.examples.walk

pub fn main() -> Unit {
    Operator CoinOp = (X + Z) * inv_sqrt2

    State<Qubit> c0 = |0>
    State<Position> x0 = dirac(0)
    State<(Qubit, Position)> (c, x) = c0 *|* x0

    state c = apply(CoinOp, c)
    state x = walk_shift(c, x)
    state c = apply(CoinOp, c)
    state x = walk_shift(c, x)

    state viewed = inspect(x)
    measure viewed
}
