// U(1) local gauge on a qubit — physical occupation is gauge-invariant
// Gauge transform: |ψ⟩ ↦ e^{iα} |ψ⟩ via phase; Born |⟨n|ψ⟩|² unchanged.
// Complements quantum_ising / expect correlators (ADR 0053).

package examples.gauge_symmetry

pub fn main() -> Unit {
    state site = |1>

    // Local U(1) phase α = π on the occupied computational state
    state gauged = phase(site, pi)

    // Occupation projector P̂ = |1⟩⟨1| (Hilbert), then compare Born weight
    state occ = project(gauged, |1>)

    state before = expect(Z, site)
    state after = expect(Z, gauged)

    // Gauge leaves ⟨Z⟩ invariant on an eigenstate of Z
    state viewed = inspect(after)
    measure occ
}
