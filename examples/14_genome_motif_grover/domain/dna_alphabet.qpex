// Tiny DNA alphabet — educational motif search (not a genome pipeline).

package com.qpex.examples.genome_motif_grover.domain

namespace Bio.Seq {
    // Four bases encoded as computational indices 0..3
    pub enum Base {
        A,
        C,
        G,   // target motif / marker in this toy
        T
    }

    pub struct MotifQuery {
        val alphabet_size: Int
        val marker_idx: Int
    }
}
