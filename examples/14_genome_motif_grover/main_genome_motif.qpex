// Genome motif Grover — amplify a marked base (toy alphabet size 4).
// Dream: find a cancer / CRISPR marker in one shot. NOT real NGS or alignment.

package com.qpex.examples.genome_motif_grover

import com.qpex.examples.genome_motif_grover.domain.dna_alphabet
import com.qpex.examples.genome_motif_grover.operators.motif_oracle

public fun main() -> Unit {
    Bio.Seq.MotifQuery q = Bio.Seq.MotifQuery(4, 2)
    // `g` harvested from Bio.Oracle.marker_index (ADR 0061)

    // Superposition over {A,C,G,T} ≡ {0,1,2,3}
    state b0 = coin()
    state b1 = coin()
    state base = b0 * 2 + b1

    state round0 = inspect(base)

    // Oracle: phase-flip G (harvested marker index)
    state marked = phase(base, pi, g)
    state amplified = grover_diffuse(marked)

    state round1 = inspect(amplified)
    state viewed_marker = inspect(g)
    state viewed_alpha = inspect(q.alphabet_size)
    measure amplified
}
