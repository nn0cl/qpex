// Multi-file DTQW — ADR 0054 module linker
// U_step = walk_shift ∘ (Coin ⊗ I), Coin ≈ R_y(π/2) = (X+Z)/√2
// 50 unitary steps via imported step_quantum_walk. Never measure(expect).

package com.qpex.examples.complex_simulations

import com.qpex.examples.complex_simulations.models.walk_environment
import com.qpex.examples.complex_simulations.models.coin_parameters
import com.qpex.examples.complex_simulations.operators.walk_operators

public fun main() {
    // Class fields (spatial_step, dt, n_steps, theta) and Operator Coin
    // are merged from imported modules by compile_path (ADR 0054).

    State<Qubit> c = |+>
    State<Position> x = dirac(0)
    State<(Qubit, Position)> (c, x) = c *|* x

    state (c, x) = evolve (c, x) times 50 {
        step_quantum_walk(c, x)
    }

    state mx = expect(X, c)
    state viewed_mx = inspect(mx)
    state viewed_x = inspect(x)

    measure x
}
