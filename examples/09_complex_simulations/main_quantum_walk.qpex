// Multi-step DTQW — self-contained until user-module import lands (ADR 0054)
// U_step = walk_shift ∘ (Coin ⊗ I), Coin ≈ R_y(π/2) = (X+Z)/√2
// 50 unitary steps. ADR 0053: never measure(expect).

package com.qpex.examples.complex_simulations

public fun main() {
    Operator Coin = 0.7071067811865476 * (X + Z)

    State<Qubit> c = |+>
    State<Position> x = dirac(0)
    State<(Qubit, Position)> (c, x) = c *|* x

    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
    state c = apply(Coin, c)
    state x = walk_shift(c, x)

    state mx = expect(X, c)
    state viewed_mx = inspect(mx)
    state viewed_x = inspect(x)

    measure x
}
