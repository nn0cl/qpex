// Walk operators — exported Operator + one DTQW step (ADR 0054)

package com.qpex.examples.complex_simulations.operators

public fun build_coin_operator() {
    Operator Coin = 0.7071067811865476 * (X + Z)
}

public fun step_quantum_walk(c, x) {
    state c = apply(Coin, c)
    state x = walk_shift(c, x)
}
