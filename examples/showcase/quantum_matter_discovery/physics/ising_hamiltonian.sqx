// Transverse-field Ising Hamiltonian — named Float coeffs returned from helper
// (LISS-0136: sparse Pauli factory scalar capture).

package com.staqex.examples.showcase.quantum_matter_discovery.physics

namespace Matter.Physics {
    pub fn build_ising_hamiltonian() -> Operator {
        Float J = 1.0
        Float h = 0.5
        Operator H = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])
        return H
    }

    pub class IsingDrive {
        pub val J: Float
        pub val h: Float

        fn init(J: Float, h: Float) {
            this.J = J
            this.h = h
        }

        pub fn named_coeff_sum() -> Float {
            Float s = this.J + this.h
            return s
        }
    }
}
