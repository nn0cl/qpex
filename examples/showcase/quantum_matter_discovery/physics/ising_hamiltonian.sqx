// Transverse-field Ising — theory-sector H(J,h) and system.hamiltonian()
// (WP-0031 / LISS-0137 / LISS-0139).

package examples.showcase.quantum_matter_discovery.physics

namespace Matter.Physics {
    pub fn build_ising_hamiltonian(J: Float, h: Float) -> Operator {
        Operator H = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])
        return H
    }

    pub class IsingDrive {
        pub val J: Float
        pub val h: Float

        fn init(J: Float, h: Float) {
            this.J = J
            this.h = h
        }

        pub fn named_coeff_sum() -> Float {
            Float s = this.J + this.h
            return s
        }

        pub fn hamiltonian() -> Operator {
            Float J = this.J
            Float h = this.h
            Operator H = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])
            return H
        }
    }
}
