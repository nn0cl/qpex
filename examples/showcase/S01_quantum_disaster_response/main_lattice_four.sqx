// staqex-lane: experiment
// CH-lattice — Zone damage / flood field (Index/Basis). Locked scenario seat.
// Arc: four-zone lattice H from binders → evolve → zone sample (wider than spine).
// WP-0089 / LISS-0289: parent-relative import (ADR 0183).
// LISS-0297: free Operator factories (no class Lattice).

package examples.showcase.s01_disaster.lattice_four_lane

import ..grid.block_costs.{damage_hamiltonian_four, basis_zone_sum}

pub fn main() -> Unit {
    Operator H = damage_hamiltonian_four()
    Operator H_basis = basis_zone_sum()

    state a = |+>
    state b = |0>
    state c = |0>
    state d = |1>
    state (a, b, c, d) = evolve (a, b, c, d) under H for 0.15
        using Suzuki(order = 2, steps = 2)
    state (a, b) = evolve (a, b) under H_basis for 0.1
        using Suzuki(order = 2, steps = 2)
    measure a tracing_out b, c, d
}
