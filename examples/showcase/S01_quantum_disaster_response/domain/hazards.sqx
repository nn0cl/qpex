// Secondary hazards after the mainshock — aftershocks, urban fire, firestorm risk.
// LISS-0294: HazardBoard is struct + free score (nested leaves already struct).

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum HazardKind {
        Aftershock,
        StructuralFire,
        FirestormRisk,
        FloodIngress
    }

    pub struct HazardCell {
        val kind: Disaster.Domain.HazardKind
        val district: Float
        val intensity: Float
        val blocks_road_weight: Float
        val evacuates_weight: Float
    }

    pub struct HazardBoard {
        val aftershock: Disaster.Domain.HazardCell
        val fire: Disaster.Domain.HazardCell
        val firestorm: Disaster.Domain.HazardCell
    }
}

pub fn hazard_cell_pressure(c: Disaster.Domain.HazardCell) -> Float {
    return c.intensity * (1.0 + c.blocks_road_weight + c.evacuates_weight)
}

// Inlined cell formula — selective import does not pull sibling free-fns (ADR 0177).
pub fn secondary_pressure(board: Disaster.Domain.HazardBoard) -> Float {
    return board.aftershock.intensity * (1.0 + board.aftershock.blocks_road_weight
            + board.aftershock.evacuates_weight)
        + board.fire.intensity * (1.0 + board.fire.blocks_road_weight
            + board.fire.evacuates_weight)
        + board.firestorm.intensity * (1.0 + board.firestorm.blocks_road_weight
            + board.firestorm.evacuates_weight)
}
