// Secondary hazards after the mainshock — aftershocks, urban fire, firestorm risk.

package com.staqex.examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum HazardKind {
        Aftershock,
        StructuralFire,
        FirestormRisk,
        FloodIngress
    }

    pub class HazardCell {
        pub val kind: Disaster.Domain.HazardKind
        pub val district: Float
        pub val intensity: Float
        pub val blocks_road_weight: Float
        pub val evacuates_weight: Float

        fn init(
            kind: Disaster.Domain.HazardKind,
            district: Float,
            intensity: Float,
            blocks_road_weight: Float,
            evacuates_weight: Float
        ) {
            this.kind = kind
            this.district = district
            this.intensity = intensity
            this.blocks_road_weight = blocks_road_weight
            this.evacuates_weight = evacuates_weight
        }

        pub fn pressure() -> Float {
            return this.intensity * (1.0 + this.blocks_road_weight + this.evacuates_weight)
        }
    }

    pub class HazardBoard {
        pub val aftershock: Disaster.Domain.HazardCell
        pub val fire: Disaster.Domain.HazardCell
        pub val firestorm: Disaster.Domain.HazardCell

        fn init(
            aftershock: Disaster.Domain.HazardCell,
            fire: Disaster.Domain.HazardCell,
            firestorm: Disaster.Domain.HazardCell
        ) {
            this.aftershock = aftershock
            this.fire = fire
            this.firestorm = firestorm
        }

        pub fn secondary_pressure() -> Float {
            return this.aftershock.intensity
                * (1.0 + this.aftershock.blocks_road_weight + this.aftershock.evacuates_weight)
                + this.fire.intensity
                * (1.0 + this.fire.blocks_road_weight + this.fire.evacuates_weight)
                + this.firestorm.intensity
                * (1.0 + this.firestorm.blocks_road_weight + this.firestorm.evacuates_weight)
        }
    }
}
