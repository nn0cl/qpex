// Comms / information cell — bandwidth priority model.
// WP-0089 / LISS-0277: FairnessReport is a score pack (struct); CommsCell keeps
// class reading as an operational cell with method headroom.

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub class CommsCell {
        pub val bandwidth: Float
        pub val feeder_a: Current
        pub val tower_up: Float
        pub val backlog: Float

        fn init(bandwidth: Float, feeder_a: Current, tower_up: Float, backlog: Float) {
            this.bandwidth = bandwidth
            this.feeder_a = feeder_a
            this.tower_up = tower_up
            this.backlog = backlog
        }

        // Feeder current scales headroom (amps as operational load proxy).
        pub fn priority_headroom() -> Float {
            Current amps = this.feeder_a
            return this.bandwidth * this.tower_up - this.backlog
        }
    }

    // Pure fairness coefficients — not a physical system.
    pub struct FairnessReport {
        val remote_weight: Float
        val loud_request_penalty: Float
        val unmet_remote: Float
    }
}

// Free score (struct has no methods).
pub fn fairness_score(r: Disaster.Domain.FairnessReport) -> Float {
    return r.remote_weight - r.loud_request_penalty - r.unmet_remote
}
