// Comms / information cell — bandwidth priority model.
// CommsCell + FairnessReport are classical packs (struct + free fns).
// LISS-0292/0293: Type-First Current field via free-fn arg.

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub struct CommsCell {
        val bandwidth: Float
        val feeder_a: Current
        val tower_up: Float
        val backlog: Float
    }

    pub struct FairnessReport {
        val remote_weight: Float
        val loud_request_penalty: Float
        val unmet_remote: Float
    }
}

pub fn priority_headroom(cell: Disaster.Domain.CommsCell) -> Float {
    Current amps = cell.feeder_a
    return cell.bandwidth * cell.tower_up - cell.backlog
}

pub fn fairness_score(r: Disaster.Domain.FairnessReport) -> Float {
    return r.remote_weight - r.loud_request_penalty - r.unmet_remote
}
