// Domain quantities — Type-First dims + SI to + mixed promote (coverage B).
// Field values seed the demo magnitudes; `to` still needs literal suffixes
// (fields lose unit tracking on conversion — Kernel limitation).

package com.staqex.examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub class Quantities {
        pub val road_km: Float
        pub val water_kg: Float
        pub val window_s: Float
        pub val feeder_a: Float
        pub val shelter_k: Float

        fn init(
            road_km: Float,
            water_kg: Float,
            window_s: Float,
            feeder_a: Float,
            shelter_k: Float
        ) {
            this.road_km = road_km
            this.water_kg = water_kg
            this.window_s = window_s
            this.feeder_a = feeder_a
            this.shelter_k = shelter_k
        }

        pub fn water_plus_payload_g() -> Mass {
            Mass water_g = 800.0.kg to g
            Mass payload_g = 500.0.g
            Mass rubble_kg = 2.0.t to kg
            Mass fuel_kg = 100.0.lb to kg
            Mass med_kg = 16.0.oz to kg
            Mass total = water_g + payload_g + rubble_kg + fuel_kg + med_kg
            Float scale = this.water_kg
            return total
        }

        pub fn window_ms() -> Time {
            Time w = 900.0.s to ms
            Float scale = this.window_s
            return w
        }

        pub fn road_m() -> Length {
            Length road = 12.0.km to m
            Current feeder = 40.0.A
            Temperature shelter = 291.0.K
            Float scale = this.road_km + this.feeder_a + this.shelter_k
            return road
        }

        pub fn scale_tag() -> Float {
            return this.road_km + this.water_kg + this.window_s
                + this.feeder_a + this.shelter_k
        }
    }
}
