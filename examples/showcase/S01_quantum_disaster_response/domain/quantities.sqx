// Domain quantities — Type-First dims + SI `to` + mixed promote (coverage B).
// Fields retain units (ADR 0174). Pack is a struct; conversions are free fns
// (LISS-0292: Type-First object args on classical free functions).

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub struct Quantities {
        val road_km: Length
        val water_kg: Mass
        val window_s: Time
        val feeder_a: Current
        val shelter_k: Temperature
    }
}

pub fn water_plus_payload_g(q: Disaster.Domain.Quantities) -> Mass {
    Mass water_g = q.water_kg to g
    Mass payload_g = 500.0.g
    Mass rubble_kg = 2.0.t to kg
    Mass fuel_kg = 100.0.lb to kg
    Mass med_kg = 16.0.oz to kg
    Mass total = water_g + payload_g + rubble_kg + fuel_kg + med_kg
    return total
}

pub fn window_ms(q: Disaster.Domain.Quantities) -> Time {
    Time w = q.window_s to ms
    return w
}

pub fn road_m(q: Disaster.Domain.Quantities) -> Length {
    Length road = q.road_km to m
    // Keep feeder/shelter reads live for Type-First coverage seats.
    Current feeder = q.feeder_a
    Temperature shelter = q.shelter_k
    return road
}

pub fn scale_tag(q: Disaster.Domain.Quantities) -> Float {
    return 1.0
}

pub fn rankine_probe_k(q: Disaster.Domain.Quantities) -> Temperature {
    Temperature t = 540.0.R to K
    return t
}

pub fn troy_probe_g(q: Disaster.Domain.Quantities) -> Mass {
    Mass m = 1.0.oz_t to g
    return m
}
