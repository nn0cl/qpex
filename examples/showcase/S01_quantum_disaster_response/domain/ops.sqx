// Ops roles and phase tags for the command room.

package com.staqex.examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum OpsPhase {
        Tonight,
        MorningCollect,
        NextDayRecovery
    }

    pub enum UnitKind {
        Rescue,
        Logistics,
        Comms
    }

    pub struct DepotStock {
        pub water_kg: Mass
        pub fuel_l_as_m3: Length
    }

    pub class CommandBoard {
        pub val phase: Disaster.Domain.OpsPhase
        pub val priority: Float

        fn init(phase: Disaster.Domain.OpsPhase, priority: Float) {
            this.phase = phase
            this.priority = priority
        }

        pub fn phase_tag() -> Float {
            Float t = this.priority
            return t
        }

        pub fn bump(delta: Float) -> Float {
            return this.priority + delta
        }
    }
}
