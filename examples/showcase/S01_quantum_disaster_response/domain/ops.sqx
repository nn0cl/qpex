// Ops roles and phase tags for the command room.
// WP-0089 / LISS-0277: CommandBoard is a classical ops pack (struct), not a system.

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum OpsPhase {
        Tonight,
        MorningCollect,
        NextDayRecovery
    }

    // phase is the authoritative OpsPhase; phase_code remains a classical score twin.
    pub struct CommandBoard {
        val phase: Disaster.Domain.OpsPhase
        val phase_code: Float
        val priority: Float
    }
}

pub fn phase_tag(board: Disaster.Domain.CommandBoard) -> Float {
    return board.phase_code + board.priority
}

pub fn phase_bump(board: Disaster.Domain.CommandBoard, delta: Float) -> Float {
    return board.priority + delta
}
