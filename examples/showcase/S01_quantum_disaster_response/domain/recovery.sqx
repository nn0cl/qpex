// Recovery / continued-rescue queue for T+1.
// LISS-0294: struct packs + free scores.

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum RecoveryKind {
        ClearRoad,
        RestorePower,
        RestoreComms,
        ContinueRescue,
        AcceptExternalAid
    }

    pub struct RecoveryItem {
        val kind: Disaster.Domain.RecoveryKind
        val effect_on_rescue: Float
        val crew_hours: Time
        val rubble_t: Mass
    }

    pub struct RecoveryQueue {
        val a: Disaster.Domain.RecoveryItem
        val b: Disaster.Domain.RecoveryItem
        val c: Disaster.Domain.RecoveryItem
        val d: Disaster.Domain.RecoveryItem
    }
}

pub fn recovery_priority(item: Disaster.Domain.RecoveryItem) -> Float {
    return item.effect_on_rescue * 10.0
}

// Inlined leaf priority — selective import does not pull sibling free-fns (ADR 0177).
pub fn queue_pressure(q: Disaster.Domain.RecoveryQueue) -> Float {
    return (q.a.effect_on_rescue * 10.0)
        + (q.b.effect_on_rescue * 10.0)
        + (q.c.effect_on_rescue * 10.0)
        + (q.d.effect_on_rescue * 10.0)
}
