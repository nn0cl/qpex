// Recovery / continued-rescue queue for T+1.

package com.staqex.examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum RecoveryKind {
        ClearRoad,
        RestorePower,
        RestoreComms,
        ContinueRescue,
        AcceptExternalAid
    }

    pub class RecoveryItem {
        pub val kind: Disaster.Domain.RecoveryKind
        pub val effect_on_rescue: Float
        pub val crew_hours: Time
        pub val rubble_t: Mass

        fn init(
            kind: Disaster.Domain.RecoveryKind,
            effect_on_rescue: Float,
            crew_hours: Time,
            rubble_t: Mass
        ) {
            this.kind = kind
            this.effect_on_rescue = effect_on_rescue
            this.crew_hours = crew_hours
            this.rubble_t = rubble_t
        }

        pub fn priority() -> Float {
            return this.effect_on_rescue * 10.0
        }

        pub fn crew_time() -> Time {
            return this.crew_hours
        }

        pub fn rubble_mass() -> Mass {
            return this.rubble_t
        }
    }

    pub class RecoveryQueue {
        pub val a: Disaster.Domain.RecoveryItem
        pub val b: Disaster.Domain.RecoveryItem
        pub val c: Disaster.Domain.RecoveryItem
        pub val d: Disaster.Domain.RecoveryItem

        fn init(
            a: Disaster.Domain.RecoveryItem,
            b: Disaster.Domain.RecoveryItem,
            c: Disaster.Domain.RecoveryItem,
            d: Disaster.Domain.RecoveryItem
        ) {
            this.a = a
            this.b = b
            this.c = c
            this.d = d
        }

        pub fn queue_pressure() -> Float {
            return (this.a.effect_on_rescue * 10.0)
                + (this.b.effect_on_rescue * 10.0)
                + (this.c.effect_on_rescue * 10.0)
                + (this.d.effect_on_rescue * 10.0)
        }
    }
}
