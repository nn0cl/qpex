// Morning observation set — next-cycle inputs (missing stays missing).
// LISS-0294: struct + free scores (Type-First Mass field).

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub struct MorningObservation {
        val roads_open_delta: Float
        val shelters_occupied: Float
        val unmet_requests: Float
        val fuel_remaining_kg: Mass
        val tower_up_fraction: Float
        val missing_fields: Float
    }
}

pub fn readiness_for_day2(obs: Disaster.Domain.MorningObservation) -> Float {
    return obs.roads_open_delta + obs.tower_up_fraction
        - obs.unmet_requests - obs.missing_fields
}

pub fn morning_tag(obs: Disaster.Domain.MorningObservation) -> Float {
    return obs.roads_open_delta + obs.shelters_occupied
        + obs.unmet_requests + obs.tower_up_fraction + obs.missing_fields
}
