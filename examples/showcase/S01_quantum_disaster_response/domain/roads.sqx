// Road graph reachability — operational corridor model (shrunk for runtime).

package com.staqex.examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum RoadState {
        Open,
        Congested,
        Blocked
    }

    pub class RoadEdge {
        pub val from_id: Float
        pub val to_id: Float
        pub val length_m: Length
        pub val road_state: Disaster.Domain.RoadState
        // 1 Open / 0.5 Congested / 0 Blocked — twin of `road_state` for classical scores.
        pub val open_weight: Float
        pub val fuel_cost_kg: Mass

        fn init(
            from_id: Float,
            to_id: Float,
            length_m: Length,
            road_state: Disaster.Domain.RoadState,
            open_weight: Float,
            fuel_cost_kg: Mass
        ) {
            this.from_id = from_id
            this.to_id = to_id
            this.length_m = length_m
            this.road_state = road_state
            this.open_weight = open_weight
            this.fuel_cost_kg = fuel_cost_kg
        }

        pub fn fuel_stock() -> Mass {
            return this.fuel_cost_kg
        }

        pub fn length() -> Length {
            return this.length_m
        }
    }

    pub class CorridorMap {
        pub val e01: Disaster.Domain.RoadEdge
        pub val e12: Disaster.Domain.RoadEdge
        pub val e23: Disaster.Domain.RoadEdge
        pub val e13: Disaster.Domain.RoadEdge

        fn init(
            e01: Disaster.Domain.RoadEdge,
            e12: Disaster.Domain.RoadEdge,
            e23: Disaster.Domain.RoadEdge,
            e13: Disaster.Domain.RoadEdge
        ) {
            this.e01 = e01
            this.e12 = e12
            this.e23 = e23
            this.e13 = e13
        }

        pub fn open_score() -> Float {
            return this.e01.open_weight + this.e12.open_weight
                + this.e23.open_weight + this.e13.open_weight
        }

        pub fn blockage_pressure() -> Float {
            return 4.0 - (this.e01.open_weight + this.e12.open_weight
                + this.e23.open_weight + this.e13.open_weight)
        }
    }
}
