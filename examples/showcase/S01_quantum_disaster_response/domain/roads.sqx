// Road graph reachability — operational corridor model (shrunk for runtime).
// LISS-0294: struct packs + free scores (Type-First free-fn args via LISS-0292).

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum RoadState {
        Open,
        Congested,
        Blocked
    }

    pub struct RoadEdge {
        val from_id: Float
        val to_id: Float
        val length_m: Length
        val road_state: Disaster.Domain.RoadState
        val open_weight: Float
        val fuel_cost_kg: Mass
    }

    pub struct CorridorMap {
        val e01: Disaster.Domain.RoadEdge
        val e12: Disaster.Domain.RoadEdge
        val e23: Disaster.Domain.RoadEdge
        val e13: Disaster.Domain.RoadEdge
    }
}

pub fn corridor_open_score(map: Disaster.Domain.CorridorMap) -> Float {
    return map.e01.open_weight + map.e12.open_weight
        + map.e23.open_weight + map.e13.open_weight
}

// Inline open sum (no nested free-fn): selective import only links named fns
// (ADR 0177), so outer scores must not call sibling helpers.
pub fn blockage_pressure(map: Disaster.Domain.CorridorMap) -> Float {
    return 4.0 - (map.e01.open_weight + map.e12.open_weight
        + map.e23.open_weight + map.e13.open_weight)
}
