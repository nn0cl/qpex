// Concurrent rescue / shelter / supply requests after the quake.

package com.staqex.examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum RequestKind {
        Entrapment,
        ShelterOpen,
        MedicalSupply,
        FuelTopUp,
        CommsPriority,
        FireFighting,
        AftershockSurvey
    }

    pub class FieldRequest {
        pub val kind: Disaster.Domain.RequestKind
        pub val urgency: Float
        pub val district: Float
        pub val people: Float

        fn init(
            kind: Disaster.Domain.RequestKind,
            urgency: Float,
            district: Float,
            people: Float
        ) {
            this.kind = kind
            this.urgency = urgency
            this.district = district
            this.people = people
        }

        pub fn score() -> Float {
            return this.urgency * this.people + this.district
        }
    }

    pub class RequestBoard {
        pub val r0: Disaster.Domain.FieldRequest
        pub val r1: Disaster.Domain.FieldRequest
        pub val r2: Disaster.Domain.FieldRequest
        pub val r3: Disaster.Domain.FieldRequest
        pub val r4: Disaster.Domain.FieldRequest

        fn init(
            r0: Disaster.Domain.FieldRequest,
            r1: Disaster.Domain.FieldRequest,
            r2: Disaster.Domain.FieldRequest,
            r3: Disaster.Domain.FieldRequest,
            r4: Disaster.Domain.FieldRequest
        ) {
            this.r0 = r0
            this.r1 = r1
            this.r2 = r2
            this.r3 = r3
            this.r4 = r4
        }

        pub fn total_people() -> Float {
            return this.r0.people + this.r1.people + this.r2.people
                + this.r3.people + this.r4.people
        }

        pub fn fairness_proxy() -> Float {
            return (this.r0.urgency * this.r0.people + this.r0.district)
                + (this.r1.urgency * this.r1.people + this.r1.district)
                + (this.r2.urgency * this.r2.people + this.r2.district)
                + (this.r3.urgency * this.r3.people + this.r3.district)
                + (this.r4.urgency * this.r4.people + this.r4.district)
        }
    }
}
