// Concurrent rescue / shelter / supply requests after the quake.
// LISS-0294: RequestBoard is struct + free scores (nested leaves already struct).

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum RequestKind {
        Entrapment,
        ShelterOpen,
        MedicalSupply,
        FuelTopUp,
        CommsPriority,
        FireFighting,
        AftershockSurvey
    }

    pub struct FieldRequest {
        val kind: Disaster.Domain.RequestKind
        val urgency: Float
        val district: Float
        val people: Float
    }

    pub struct RequestBoard {
        val r0: Disaster.Domain.FieldRequest
        val r1: Disaster.Domain.FieldRequest
        val r2: Disaster.Domain.FieldRequest
        val r3: Disaster.Domain.FieldRequest
        val r4: Disaster.Domain.FieldRequest
    }
}

pub fn field_request_score(r: Disaster.Domain.FieldRequest) -> Float {
    return r.urgency * r.people + r.district
}

pub fn total_people(board: Disaster.Domain.RequestBoard) -> Float {
    return board.r0.people + board.r1.people + board.r2.people
        + board.r3.people + board.r4.people
}

// Inlined leaf scores — selective import does not pull sibling free-fns (ADR 0177).
pub fn fairness_proxy(board: Disaster.Domain.RequestBoard) -> Float {
    return (board.r0.urgency * board.r0.people + board.r0.district)
        + (board.r1.urgency * board.r1.people + board.r1.district)
        + (board.r2.urgency * board.r2.people + board.r2.district)
        + (board.r3.urgency * board.r3.people + board.r3.district)
        + (board.r4.urgency * board.r4.people + board.r4.district)
}
