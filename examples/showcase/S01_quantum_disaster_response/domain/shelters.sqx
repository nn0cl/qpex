// Shelter capacity and occupancy — command-room inventory model.
// LISS-0294: struct packs + free scores.

package examples.showcase.s01_disaster.domain

namespace Disaster.Domain {
    pub enum ShelterStatus {
        Open,
        NearFull,
        ClosedFlooded
    }

    pub struct ShelterSite {
        val capacity: Float
        val occupied: Float
        val water_kg: Mass
        val temp_k: Temperature
        val status: Disaster.Domain.ShelterStatus
        val open_weight: Float
    }

    pub struct ShelterBoard {
        val coastal: Disaster.Domain.ShelterSite
        val inland: Disaster.Domain.ShelterSite
        val hill: Disaster.Domain.ShelterSite
    }
}

pub fn shelter_remaining(s: Disaster.Domain.ShelterSite) -> Float {
    return s.capacity - s.occupied
}

// Inlined leaf math — selective import does not pull sibling free-fns (ADR 0177).
pub fn total_remaining(board: Disaster.Domain.ShelterBoard) -> Float {
    return (board.coastal.capacity - board.coastal.occupied)
        + (board.inland.capacity - board.inland.occupied)
        + (board.hill.capacity - board.hill.occupied)
}

pub fn shelter_pressure_tag(board: Disaster.Domain.ShelterBoard) -> Float {
    return (board.coastal.occupied / board.coastal.capacity)
        + (board.inland.occupied / board.inland.capacity)
        + (board.hill.occupied / board.hill.capacity)
        + (3.0 - (board.coastal.open_weight + board.inland.open_weight
            + board.hill.open_weight))
}
