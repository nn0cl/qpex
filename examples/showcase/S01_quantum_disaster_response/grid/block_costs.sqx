// Indexed block costs — many-body binders on a small district lattice.
// Domains sized for the tonight spine's two-wire evolve (LISS-0224).
// Note: `sum … where i < j { Z[i]*Z[j] }` still needs QubitRegister<N> for
// identity acting-space; use explicit two-site Pauli or plain sum/product.

package com.staqex.examples.showcase.s01_disaster.grid

namespace Disaster.Grid {
    pub class Lattice {
        pub val n_blocks: Float

        fn init(n_blocks: Float) {
            this.n_blocks = n_blocks
        }

        pub fn damage_hamiltonian() -> Operator {
            Operator H = Z[0] * Z[1]
            return H
        }

        pub fn corridor_product() -> Operator {
            Operator P = product (i in Index<0..1>) { Z[i] }
            return P
        }

        pub fn flood_zone_sum() -> Operator {
            Operator H = sum (i in Index<0..1>) { X[i] }
            return H
        }

        pub fn lattice_tag() -> Float {
            return this.n_blocks
        }
    }
}
