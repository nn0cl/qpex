// Indexed block costs — 2-wire tonight binders + 4-site satellite (LISS-0232).

package examples.showcase.s01_disaster.grid

namespace Disaster.Grid {
    pub class Lattice {
        pub val n_blocks: Float

        fn init(n_blocks: Float) {
            this.n_blocks = n_blocks
        }

        pub fn damage_hamiltonian() -> Operator {
            Operator H = sum (i in Index<0..1>, j in Index<0..1>) where i < j {
                Z[i] * Z[j]
            }
            return H
        }

        // Four-block district lattice (satellite main_lattice_four).
        pub fn damage_hamiltonian_four() -> Operator {
            Operator H = sum (i in Index<0..3>, j in Index<0..3>) where i < j {
                Z[i] * Z[j]
            }
            return H
        }

        pub fn basis_zone_sum() -> Operator {
            Operator H = sum (i in Basis<2>) { Z[i] }
            return H
        }

        pub fn corridor_product() -> Operator {
            Operator P = product (i in Index<0..1>) { Z[i] }
            return P
        }

        pub fn flood_zone_sum() -> Operator {
            Operator H = sum (i in Index<0..1>) { X[i] }
            return H
        }

        pub fn lattice_tag() -> Float {
            return this.n_blocks
        }
    }
}
