// staqex-lane: experiment
// CH-fidelity — Prior vs proposal fidelity (`inner`/`outer`). Locked scenario seat.
// Arc: plan prior vs current proposal overlap → fidelity peek before commit.

package examples.showcase.s01_disaster.protocol_observe

pub fn main() -> Unit {
    state prior = |+>
    state current = |+>
    state overlap = inner(prior, current)
    Operator projector = outer(current, prior)
    state probe = |0>
    state probe = apply(projector, probe)
    measure overlap tracing_out prior, current, probe
}
