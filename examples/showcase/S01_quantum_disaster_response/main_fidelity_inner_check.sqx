// Dirac inner/outer — Joint runtime (LISS-0229 / ADR 0087).

package com.staqex.examples.showcase.s01_disaster.protocol_observe

pub fn main() -> Unit {
    state prior = |+>
    state current = |+>
    state overlap = inner(prior, current)
    Operator projector = outer(current, prior)
    state probe = |0>
    state probe = apply(projector, probe)
    state prior = |0>
    state current = |0>
    state probe = |0>
    measure overlap
}
