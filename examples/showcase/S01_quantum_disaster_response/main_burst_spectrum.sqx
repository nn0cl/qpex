// CH-burst — Sensor / RF burst spectrum (circuit sub-lane). Locked scenario seat.

package com.staqex.examples.showcase.s01_disaster.spectrum_lane

pub fn main() -> Unit {
    QubitRegister<1> ctrl = system()
    QubitRegister<2> register = system()
    forEach q in register {
        apply(H, q)
    }
    Operator F = qft(register)
    Operator inverse_F = iqft(register)
    Operator CF = cqft(ctrl, register)

    state burst = |+>
    state probe = |0>
    state (burst, probe) = apply(F, burst, probe)
    state (burst, probe) = apply(inverse_F, burst, probe)
    state c = |1>
    state (c, burst, probe) = apply(CF, c, burst, probe)
    state correlation = expect(ZZ, burst, probe)
    state viewed = inspect(correlation)
    measure probe tracing_out burst, c
}
