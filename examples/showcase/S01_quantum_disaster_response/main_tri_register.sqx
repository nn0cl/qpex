// Tri-register logistics metaphor — uses physics/tri_register.sqx `system`.

package com.staqex.examples.showcase.s01_disaster.tri_lane

import com.staqex.examples.showcase.s01_disaster.physics.tri_register

pub fn main() -> Unit {
    Operator<RegisterSet<DisasterLink>> zz = Z[rescue[0]] * Z[logistics[0]]

    state rescue = |0>
    state logistics = |0>
    state logistics = cnot(rescue, logistics)
    state corr = expect(ZZ, rescue, logistics)
    state viewed = inspect(corr)
    state logistics = cnot(rescue, logistics)
    state logistics = |0>
    measure rescue
}
