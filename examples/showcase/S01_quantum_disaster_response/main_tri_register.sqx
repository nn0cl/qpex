// CH-tri — Multi-command registers (rescue × logistics × fire). Locked seat.
// Arc: coupled command registers → contention-style ZZ → multi-register measure.
// Linear discipline: rebound both wires after cnot (ADR 0168 style).

package examples.showcase.s01_disaster.tri_lane

import ..physics.tri_register

pub fn main() -> Unit {
    Operator<RegisterSet<DisasterLink>> zz = Z[rescue[0]] * Z[logistics[0]]

    state rescue = |0>
    state logistics = |0>
    state (rescue, logistics) = cnot(rescue, logistics)
    state corr = expect(ZZ, rescue, logistics)
    state viewed = inspect(corr)
    state (rescue, logistics) = cnot(rescue, logistics)
    measure rescue tracing_out logistics
}
