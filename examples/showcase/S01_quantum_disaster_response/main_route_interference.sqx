// staqex-lane: experiment
// CH-route — Competing corridor phases (E-lane). Locked scenario seat.
// Arc: two corridor amplitudes with relative phase → interference → route sample.
// WP-0089: selective import short names (ADR 0177).

package examples.showcase.s01_disaster.phase_lane

import examples.showcase.s01_disaster.physics.interference.{RouteBoard, route_interference_tag, relative_phase_tag}

pub fn main() -> Unit {
    RouteBoard routes = RouteBoard(0.6, 0.4)
    Float route_tag = route_interference_tag(routes)
    Float phase_delta = relative_phase_tag(routes)

    state left = |+>
    state right = |+>
    state left = phase(left, 0.35)
    state right = phase(right, -0.35)
    state corr = expect(ZZ, left, right)
    state viewed_corr = inspect(corr)
    measure left tracing_out right
}
