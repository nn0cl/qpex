// staqex-lane: experiment
// CH-day2 — Day-2 recovery / continued rescue (Suzuki S4). Locked scenario seat.
// Arc: recovery drive H + S4 policy → day-2 plan sample (not tonight re-run).
// WP-0089 / LISS-0289: parent-relative import (ADR 0183) + selective names.

package examples.showcase.s01_disaster.day2_lane

import ..domain.ops.{CommandBoard, OpsPhase, phase_tag}
import ..domain.recovery.{RecoveryItem, RecoveryKind, RecoveryQueue}
import ..domain.morning.{MorningObservation}
import ..domain.comms_ops.{CommsCell, FairnessReport, fairness_score, priority_headroom}
import ..domain.hazards.{HazardCell, HazardKind, HazardBoard}
import ..domain.theatre_scale
import ..physics.constraint_h.{ConstraintCoeffs, ConstraintDrive}
import ..provenance.honesty.{HonestyDossier}

use OpsPhase.*

pub fn main() -> Unit {
    CommandBoard board =
        CommandBoard(
            OpsPhase.NextDayRecovery, 2.0, 1.2
        )
    Float phase_pri = phase_tag(board)

    RecoveryItem a =
        RecoveryItem(
            RecoveryKind.ClearRoad, 0.9, 7200.0.s, 3.0.t
        )
    // Read Type-First fields before queue construction (init moves ownership).
    Time crew = a.crew_time()
    Mass rubble = a.rubble_mass()
    RecoveryItem b =
        RecoveryItem(
            RecoveryKind.RestorePower, 0.7, 5400.0.s, 1.5.t
        )
    RecoveryItem c =
        RecoveryItem(
            RecoveryKind.RestoreComms, 0.8, 3600.0.s, 0.5.t
        )
    RecoveryItem d =
        RecoveryItem(
            RecoveryKind.ContinueRescue, 0.95, 10800.0.s, 4.0.t
        )
    RecoveryQueue queue = RecoveryQueue(a, b, c, d)
    Float pressure = queue.queue_pressure()

    HazardCell hz_after =
        HazardCell(
            HazardKind.Aftershock, 2.0, 0.35, 0.0, 0.0
        )
    HazardCell hz_fire =
        HazardCell(
            HazardKind.StructuralFire, 1.0, 0.5, 1.0, 0.0
        )
    HazardCell hz_storm =
        HazardCell(
            HazardKind.FirestormRisk, 0.0, 0.2, 0.0, 1.0
        )
    HazardBoard hazards = HazardBoard(hz_after, hz_fire, hz_storm)
    Float hazard_carry = hazards.secondary_pressure()

    MorningObservation obs = MorningObservation(
        2.0,
        1.5,
        30.0 + hazard_carry,
        180.0.kg,
        0.7,
        1.0
    )
    Float ready = obs.readiness_for_day2()

    CommsCell comms = CommsCell {
        bandwidth: 1.0, feeder_a: 40.0.A, tower_up: 0.7, backlog: 0.3
    }
    Float headroom = priority_headroom(comms)
    FairnessReport fair = FairnessReport {
        remote_weight: 1.0, loud_request_penalty: 0.2, unmet_remote: 0.4
    }
    Float fair_score = fairness_score(fair)

    ConstraintCoeffs coeffs = ConstraintCoeffs(0.6, 0.5, 0.0)
    ConstraintDrive drive = ConstraintDrive(coeffs)
    Operator H = drive.recovery_hamiltonian()
    Float coeff_sum = drive.named_coeff_sum()
    // Suzuki order is the evolve clause itself (no fake suzuki_*_tag).
    Float suzuki_order = 4.0

    HonestyDossier dossier = HonestyDossier(1.0, 5.0)
    Float honesty_v = dossier.sim_lane

    Float mean_cell = mean_cell_population()
    Float capital_cells_v = capital_cells()
    Float capital_qpu = capital_qpu_recommended()

    state plan0 = when (board.phase) {
      Tonight -> |0>,
      MorningCollect -> |+>,
      NextDayRecovery -> |1>,
      else -> |0>,
    }
    state bit = coin()
    state plan_branch = when (bit) {
      0 -> |0>,
      else -> |+>,
    }

    state plan1 = |+>
    state (plan0, plan1) = evolve (plan0, plan1) under H for 0.9
        using Suzuki(order = 4, steps = 8)
    state zz = expect(ZZ, plan0, plan1)
    // Sparse notebook peek (not Float-tag flood).
    state viewed_zz = inspect(zz)
    measure plan0 tracing_out plan1, plan_branch
}
