// staqex-lane: experiment
// CH-tonight-spine — E-lane Joint experiment (LISS-0246 dialect; LISS-0256 causal).
//
// Causal map (domain → Joint) — LISS-0256 (honest; re-review hygiene):
//   board.phase / coastal.status     → when arms (plan0, shelter_gate)
//   corridor.blockage_pressure()     → ConstraintCoeffs.congestion → H_drive
//   fair_report.score() + readiness  → ConstraintCoeffs.fairness   → H_drive
//   requests.total_people()          → fairness_c + t_drive load term
//   hazards.secondary_pressure()     → t_damage under H_damage
//   corridor.open_score()            → t_corridor under H_corridor
//   PlanWindow.t() / haul_score      → t_drive base + truck term
//   qty Type-First converts          → live unit paths (window/water/rankine/troy);
//                                      not cast to bare Float schedule (no SI→f64 claim)
//   coin() / ration / compose_*      → plan_branch + Classical⊕State + pipe Fusion
// Host owns structured logs / TonightTicket (LISS-0243). SIM-only; not city optimum.
// WP-0089 / LISS-0276: selective import short names (ADR 0177).

package examples.showcase.s01_disaster

import examples.showcase.s01_disaster.domain.ops.{CommandBoard, OpsPhase}
import examples.showcase.s01_disaster.domain.quantities.{Quantities}
import examples.showcase.s01_disaster.domain.capabilities.{RescueSquad, SupplyTruck, readiness_of, haul_score}
import examples.showcase.s01_disaster.domain.shelters.{ShelterSite, ShelterStatus}
import examples.showcase.s01_disaster.domain.roads.{RoadEdge, RoadState, CorridorMap}
import examples.showcase.s01_disaster.domain.requests.{FieldRequest, RequestKind, RequestBoard}
import examples.showcase.s01_disaster.domain.comms_ops.{FairnessReport, fairness_score}
import examples.showcase.s01_disaster.domain.hazards.{HazardCell, HazardKind, HazardBoard}
import examples.showcase.s01_disaster.grid.block_costs.{Lattice}
import examples.showcase.s01_disaster.physics.constraint_h.{ConstraintCoeffs, ConstraintDrive}
import examples.showcase.s01_disaster.protocol.windows.{PlanWindow}
import examples.showcase.s01_disaster.protocol.compose

use OpsPhase.*
use ShelterStatus.*

pub fn main() -> Unit {
    // --- Classical ops packs (H-adjacent library; feed Joint below) ---
    CommandBoard board = CommandBoard(OpsPhase.Tonight, 0.0, 1.0)

    Quantities qty = Quantities(
        12.0.km,
        800.0.kg,
        900.0.s,
        40.0.A,
        291.0.K
    )
    // Type-First field units (ADR 0174): keep convert paths live for scorecard B.
    // These stay dimensioned — they do *not* silently become evolve Float times.
    Time window_ms = qty.window_ms()
    Mass water_g = qty.water_plus_payload_g()
    Temperature rankine_k = qty.rankine_probe_k()
    Mass troy_g = qty.troy_probe_g()
    Length road_m = qty.road_m()
    // Dimensionless Joint schedule (ops window narrative 900s / roll 15 min).
    PlanWindow win = PlanWindow(0.6, 15.0)
    Float duration = win.t()
    Float roll_min = win.roll_tag()

    ShelterSite coastal =
        ShelterSite(
            400.0, 320.0, 900.0.kg, 290.0.K,
            ShelterStatus.Open, 1.0
        )

    RoadEdge e01 =
        RoadEdge(
            0.0, 1.0, 1500.0.m, RoadState.Open, 1.0, 18.0.kg
        )
    RoadEdge e12 =
        RoadEdge(
            1.0, 2.0, 2200.0.m, RoadState.Open, 1.0, 30.0.kg
        )
    RoadEdge e23 =
        RoadEdge(
            2.0, 3.0, 1800.0.m, RoadState.Blocked, 0.0, 22.0.kg
        )
    RoadEdge e13 =
        RoadEdge(
            1.0, 3.0, 3000.0.m, RoadState.Congested, 0.5, 28.0.kg
        )
    CorridorMap corridor =
        CorridorMap(e01, e12, e23, e13)
    Float blockage = corridor.blockage_pressure()
    Float open_score = corridor.open_score()

    FieldRequest req0 =
        FieldRequest(
            RequestKind.Entrapment, 0.95, 0.0, 8.0
        )
    FieldRequest req1 =
        FieldRequest(
            RequestKind.ShelterOpen, 0.7, 2.0, 60.0
        )
    FieldRequest req2 =
        FieldRequest(
            RequestKind.MedicalSupply, 0.8, 1.0, 35.0
        )
    FieldRequest req3 =
        FieldRequest(
            RequestKind.FuelTopUp, 0.6, 3.0, 20.0
        )
    FieldRequest req4 =
        FieldRequest(
            RequestKind.FireFighting, 0.9, 4.0, 5.0
        )
    RequestBoard requests =
        RequestBoard(req0, req1, req2, req3, req4)

    FairnessReport fair_report =
        FairnessReport(1.0, 0.15, 0.35)
    Float fair = fairness_score(fair_report)

    HazardCell hz_after =
        HazardCell(
            HazardKind.Aftershock, 2.0, 0.7, 1.0, 0.0
        )
    HazardCell hz_fire =
        HazardCell(
            HazardKind.StructuralFire, 0.0, 0.85, 1.0, 1.0
        )
    HazardCell hz_storm =
        HazardCell(
            HazardKind.FirestormRisk, 0.0, 0.55, 0.0, 1.0
        )
    HazardBoard hazards =
        HazardBoard(hz_after, hz_fire, hz_storm)
    Float hazard_pressure = hazards.secondary_pressure()

    // Capability impl seat (readiness / haul still domain protocols).
    RescueSquad squad = RescueSquad(0.9)
    SupplyTruck truck = SupplyTruck(1.5)
    Float ready = readiness_of(squad)
    Float load = haul_score(truck)

    // Congestion from corridor blockage; fairness from audit + readiness + request load.
    Float congestion = blockage * 0.4
    Float people_total = requests.total_people()
    Float request_load = people_total * 0.002
    Float fairness_c = fair * 0.5 + ready * 0.2 + request_load
    ConstraintCoeffs coeffs =
        ConstraintCoeffs(congestion, fairness_c, 0.0)
    ConstraintDrive drive =
        ConstraintDrive(coeffs)
    Operator H_drive = drive.hamiltonian()

    Lattice lattice = Lattice(4.0)
    Operator H_damage = lattice.damage_hamiltonian()
    Operator H_corridor = lattice.corridor_product()
    Operator H_flood = lattice.flood_zone_sum()

    // Evolve times from domain pressures + PlanWindow (not anonymous-only).
    Float t_drive = duration + load * 0.05 + request_load + roll_min * 0.001
    Float t_damage = hazard_pressure * 0.03
    Float t_flood = 0.1
    Float t_corridor = open_score * 0.04

    // Classical⊕State fair-share ticket.
    state ration: State<Int> = 2 / 3
    state ration = ration + (1 / 4)

    // Priority pipe / Partial / poly Fusion (dispatch desk SE-05/06).
    state composed = compose_priority(3)
    state pair_sum = compose_pair(2, 5)
    state poly = compose_poly(2)
    state bumped_pri = local_priority_bump(1)

    // Enum when — phase and shelter status gate the plan wire.
    state plan0 = when (board.phase) {
      Tonight -> |0>,
      MorningCollect -> |+>,
      NextDayRecovery -> |1>,
      else -> |0>,
    }
    state shelter_gate = when (coastal.status) {
      Open -> |+>,
      NearFull -> |0>,
      ClosedFlooded -> |1>,
      else -> |0>,
    }
    state bit = coin()
    state plan_branch = when (bit) {
      0 -> |0>,
      else -> |+>,
    }

    state plan1 = |+>
    state (plan0, plan1) = evolve (plan0, plan1) under H_drive for t_drive
        using Suzuki(order = 2, steps = 4)
    state (plan0, plan1) = evolve (plan0, plan1) under H_damage for t_damage
        using Suzuki(order = 2, steps = 4)
    state (plan0, plan1) = evolve (plan0, plan1) under H_flood for t_flood
        using Suzuki(order = 2, steps = 2)
    state (plan0, plan1) = evolve (plan0, plan1) under H_corridor for t_corridor
        using Suzuki(order = 2, steps = 2)

    state zz = expect(ZZ, plan0, plan1)

    // ADR 0173: leftovers leave via Born partial trace.
    measure plan0 tracing_out plan1, ration, composed, pair_sum, poly,
        bumped_pri, shelter_gate, plan_branch
}
