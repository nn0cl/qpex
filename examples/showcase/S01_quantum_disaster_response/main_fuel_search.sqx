// CH-fuel — Fuel / resource search under convergence budget.
// Non-placeable on static QPU IR (soft E_QPU_UNSUPPORTED_CAPABILITY). Not the spine.

package com.staqex.examples.showcase.s01_disaster.fuel_lane

pub fn main() -> Unit {
    state fuel = dirac(0)
    state fuel = evolve fuel under X for pi / 2.0 until converged(fuel) max 64
    measure fuel
}
