// Plan composition via pipe / Partial (ADR 0143 / 0149 / 0152).
// Pipeline RHS must be a free function call or unary fn name (not `this.method`).

package com.staqex.examples.showcase.s01_disaster.protocol

fn add_priority(x: State<Int>, y: State<Int>) -> State<Int> {
    return x + y
}

fn dbl_priority(s: State<Int>) -> State<Int> {
    return s * 2
}

fn compose_priority(seed: State<Int>) -> State<Int> {
    return seed |> add_priority(10, _) |> dbl_priority
}

fn compose_pair(a: State<Int>, b: State<Int>) -> State<Int> {
    return (a, b) |> add_priority(_, _)
}

namespace Disaster.Protocol {
    pub class PriorityPipe {
        pub val seed_tag: Float

        fn init(seed_tag: Float) {
            this.seed_tag = seed_tag
        }

        pub fn tag() -> Float {
            return this.seed_tag
        }
    }
}
