// Protocol windows — duration / roll only (no passthrough fidelity fake).

package examples.showcase.s01_disaster.protocol

namespace Disaster.Protocol {
    pub class PlanWindow {
        pub val duration: Float
        pub val roll_minutes: Float

        fn init(duration: Float, roll_minutes: Float) {
            this.duration = duration
            this.roll_minutes = roll_minutes
        }

        pub fn t() -> Float {
            return this.duration
        }

        pub fn roll_tag() -> Float {
            return this.roll_minutes
        }
    }
}
