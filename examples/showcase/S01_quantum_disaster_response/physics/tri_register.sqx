// Tri-system metaphor registers — rescue / logistics / comms sites.

package com.staqex.examples.showcase.s01_disaster.physics

system DisasterLink {
    register rescue : QubitRegister<1>
    register logistics : QubitRegister<1>
    register comms : QubitRegister<1>
}

namespace Disaster.Physics {
    pub fn link_coupling_tag() -> Float {
        Float t = 1.0
        return t
    }
}
