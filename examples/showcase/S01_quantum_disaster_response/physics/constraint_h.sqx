// Constraint Hamiltonian — struct coeffs + free Operator factories.
// LISS-0297: Operator free-fn struct field coeffs (no class drive).

package examples.showcase.s01_disaster.physics

namespace Disaster.Physics {
    // Immutable named coefficients; `_pad` exercises module-private visibility.
    pub struct ConstraintCoeffs {
        pub val congestion: Float
        pub val fairness: Float
        val _pad: Float
    }
}

pub fn constraint_hamiltonian(c: Disaster.Physics.ConstraintCoeffs) -> Operator {
    return c.congestion * (Z[0] * Z[1]) + c.fairness * (X[0] + X[1])
}

pub fn recovery_hamiltonian(c: Disaster.Physics.ConstraintCoeffs) -> Operator {
    return (c.congestion + c.fairness) * (Z[0] * Z[1]) + c.fairness * X[0]
}

pub fn named_coeff_sum(c: Disaster.Physics.ConstraintCoeffs) -> Float {
    return c.congestion + c.fairness
}
