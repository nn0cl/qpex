// Constraint Hamiltonian with named coefficients (struct fields).

package com.staqex.examples.showcase.s01_disaster.physics

namespace Disaster.Physics {
    pub class ConstraintDrive {
        pub val congestion: Float
        pub val fairness: Float

        fn init(congestion: Float, fairness: Float) {
            this.congestion = congestion
            this.fairness = fairness
        }

        pub fn hamiltonian() -> Operator {
            Float c = this.congestion
            Float f = this.fairness
            Operator H = c * (Z[0] * Z[1]) + f * (X[0] + X[1])
            return H
        }

        // Higher-order Trotter story for day-2 recovery window (ops accuracy).
        pub fn recovery_hamiltonian() -> Operator {
            Float c = this.congestion
            Float f = this.fairness
            Operator H = (c + f) * (Z[0] * Z[1]) + f * X[0]
            return H
        }

        pub fn named_coeff_sum() -> Float {
            return this.congestion + this.fairness
        }

        pub fn suzuki_order_tag() -> Float {
            Float order = 2.0
            return order
        }

        pub fn suzuki_s4_tag() -> Float {
            Float order = 4.0
            return order
        }
    }
}
