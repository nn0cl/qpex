// Constraint Hamiltonian — struct coeffs + class drive (ledger struct/_).

package examples.showcase.s01_disaster.physics

namespace Disaster.Physics {
    // Immutable named coefficients; `_pad` exercises module-private visibility.
    pub struct ConstraintCoeffs {
        pub val congestion: Float
        pub val fairness: Float
        val _pad: Float
    }

    pub class ConstraintDrive {
        pub val congestion: Float
        pub val fairness: Float

        fn init(coeffs: Disaster.Physics.ConstraintCoeffs) {
            this.congestion = coeffs.congestion
            this.fairness = coeffs.fairness
        }

        pub fn hamiltonian() -> Operator {
            Float c = this.congestion
            Float f = this.fairness
            Operator H = c * (Z[0] * Z[1]) + f * (X[0] + X[1])
            return H
        }

        pub fn recovery_hamiltonian() -> Operator {
            Float c = this.congestion
            Float f = this.fairness
            Operator H = (c + f) * (Z[0] * Z[1]) + f * X[0]
            return H
        }

        pub fn named_coeff_sum() -> Float {
            return this.congestion + this.fairness
        }
    }
}
