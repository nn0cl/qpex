// Competing-route interference tag (phase narrative for coverage B05).

package com.staqex.examples.showcase.s01_disaster.physics

namespace Disaster.Physics {
    pub class RouteBoard {
        pub val a: Float
        pub val b: Float

        fn init(a: Float, b: Float) {
            this.a = a
            this.b = b
        }

        pub fn route_interference_tag() -> Float {
            return this.a + this.b
        }

        // Classical stand-in for relative phase magnitude (ops report).
        pub fn relative_phase_tag() -> Float {
            return this.a - this.b
        }
    }
}
