// Competing-route interference tag (phase narrative for coverage B05).
// WP-0089 / LISS-0277: RouteBoard is a classical tag pack (struct).

package examples.showcase.s01_disaster.physics

namespace Disaster.Physics {
    pub struct RouteBoard {
        val a: Float
        val b: Float
    }
}

pub fn route_interference_tag(board: Disaster.Physics.RouteBoard) -> Float {
    return board.a + board.b
}

pub fn relative_phase_tag(board: Disaster.Physics.RouteBoard) -> Float {
    return board.a - board.b
}
