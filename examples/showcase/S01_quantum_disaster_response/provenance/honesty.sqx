// Honesty + slightly-future static target declaration (no live submit).
// WP-0089 / LISS-0277: dossier is a tag pack (struct).

package examples.showcase.s01_disaster.provenance

namespace Disaster.Provenance {
    pub struct HonestyDossier {
        val sim_lane: Float
        val future_target: Float
    }
}

pub fn honesty(d: Disaster.Provenance.HonestyDossier) -> Float {
    return d.sim_lane
}

pub fn target_tag(d: Disaster.Provenance.HonestyDossier) -> Float {
    return d.future_target
}
