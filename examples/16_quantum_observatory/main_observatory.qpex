// Quantum Observatory — a molecular-spectrum mission in one executable story.
// The source intentionally keeps the theory, instrument, and terminal
// observation visible together so the accepted QPex surface can be reviewed
// without opening a second language or a provider SDK.

package com.qpex.examples.quantum_observatory

import com.qpex.examples.quantum_observatory.domain.observatory_config
import com.qpex.examples.quantum_observatory.domain.topology
import com.qpex.examples.quantum_observatory.domain.link_parties
import com.qpex.examples.quantum_observatory.operators.ssh_hamiltonian
import com.qpex.examples.quantum_observatory.operators.interferometer
import com.qpex.examples.quantum_observatory.operators.walk_step
import com.qpex.examples.quantum_observatory.operators.search_oracle
import com.qpex.examples.quantum_observatory.operators.bell_channel

theory SpectralTheory {
    Operator Model = X + Z
}

experiment SpectralExperiment {
    theory = SpectralTheory
}

workflow SpectralSweep {
    experiment = SpectralExperiment
    parameter theta : Param<Angle>
    observable spectrum
    until spectrum <= 0.01
}

interface System {}

interface Evolvable<T> {
    fn advance(x: State<T>) -> State<T>
}

class SpectrometerSystem : System {
    Float gain = 1.0
}

impl Evolvable<Float> for SpectrometerSystem {
    fn advance(x: State<Float>) -> State<Float> {
        return x
    }
}

pub fn preserve_probe(x: State<Qubit>) -> State<Qubit> {
    return x
}

pub fn main() -> Unit {
    Observatory.Config config = Observatory.Config(3, 0.25, 0)
    // The capsule is deliberately visible at the boundary: configuration is
    // data, while the state evolution below is the physical calculation.
    Observatory.Run mission = Observatory.Run(config)
    State<Float> tick = mission.advance()

    Observatory.Topology.Chain chain =
        Observatory.Topology.Chain(2, Observatory.Topology.BoundaryCondition.Open)
    Observatory.Link.OpticalHop hop = Observatory.Link.OpticalHop(0, 1)

    State<Position> site = dirac(0)
    Operator Hssh = build_ssh_hamiltonian()
    state site = evolve site under Hssh for config.duration
    state phased = phase(site, pi)
    state viewed_site = inspect(phased)

    // Interferometer: two shared paths cancel at the middle screen bin.
    state slit = coin()
    state path_a = when (slit) { 0 -> 0, else -> 1 }
    state path_b0 = when (slit) { 0 -> 1, else -> 2 }
    state path_b = phase(path_b0, pi)
    state screen = interfer(path_a, path_b)
    state mapped_screen = map(screen, v -> v)
    state selected_screen = project(mapped_screen, |1>)
    snapshot selected_screen to stdout

    // A typed walk over a qubit coin and a position carrier. The step lives
    // in the operator module, so the main narrative shows the subsystem call.
    State<Qubit> c0 = |0>
    State<Position> x0 = dirac(0)
    Operator walk_operator = build_observatory_coin()
    State<(Qubit, Position)> (c, x) = c0 *|* x0
    state (c, x) = evolve (c, x) times 1 {
        walk_observatory_step(walk_operator, c, x)
    }

    // Grover instrument: phase mark followed by inversion about the mean.
    state gb0 = coin()
    state gb1 = coin()
    state index = gb0 * 2 + gb1
    state marked = phase(index, pi, 2)
    state amplified = grover_diffuse(marked)
    state viewed_search = inspect(amplified)

    // The CPU story names controlled variants; the QPU lane stays small.
    state control_a = |1>
    state control_b = |1>
    state target = |0>
    state target = capply(control_a, control_b, X, target)
    state open_target = |0>
    state open_target = ocapply(control_a, control_b, X, open_target)
    state mixed_target = |0>
    state mixed_target = capply(control_a, !control_b, X, mixed_target)
    state toffoli_target = |0>
    state toffoli_target = toffoli(control_a, control_b, toffoli_target)

    // Trace the coin factor out before observing the position factor.
    State<(Qubit, Position)> (trace_coin, trace_position) = |+> *|* dirac(0)
    state _traced_coin = trace_out(trace_coin)
    snapshot phased to stdout

    // Static QPU lane: the register shape is known before execution. The
    // workflow's `theta` parameter never controls circuit size.
    QubitRegister<3> register = system()
    Operator F = qft(register)
    Operator inverse_F = iqft(register)

    // Pipeline application remains a pure State-to-State function boundary.
    State<Qubit> pipeline_input = |0>
    state piped = pipeline_input |> preserve_probe()

    // The same Hamiltonian is shown with both accepted static S2 policies.
    Operator H = X + Z
    state fixed_steps = evolve piped under H for 1.0.s
        using Suzuki(order = 2, steps = 8)
    state tolerance_steps = evolve fixed_steps under H for 1.0.s
        using Suzuki(order = 2, tolerance = 1e-4, error = EmpiricalEstimate)

    // CPU-only continuous observatory lane (see cpu/continuous_models.qpex):
    // Fock, grid, and sparse-Pauli carriers remain explicit separate models.

    // Φ⁺ link witness: |+⟩|0⟩ → CNOT → correlated pair.
    state observatory = |+>
    state probe = |0>
    state probe = cnot(observatory, probe)
    state correlation = expect(ZZ, observatory, probe)
    state viewed_correlation = inspect(correlation)

    // Open-system detector readout. No implicit normalization or hidden
    // observation occurs before this final terminal boundary.
    DensityState<Qubit> rho = DensityState(
        RawMatrix([
            [1.0, 0.0],
            [0.0, 0.0]
        ])
    )
    DensityState<Qubit> observed = lindblad(
        rho,
        H,
        JumpSet([RawMatrix([
                [0.0, 1.0],
                [0.0, 0.0]
            ])]),
        0.1
    )
    measure observed
}
