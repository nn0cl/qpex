// Qubit coin used by the later discrete-time walk slice.

package com.qpex.examples.quantum_observatory.operators

pub fn build_observatory_coin() -> Operator {
    Operator WalkCoin = (X + Z) * inv_sqrt2
    return WalkCoin
}

pub fn walk_observatory_step(operator: Operator, c: State<Qubit>, x: State<Position>) -> State<(Qubit, Position)> {
    State<Qubit> c = apply(operator, c)
    State<Position> x = walk_shift(c, x)
    return c *|* x
}
