// Phase constants for the observatory's interference instrument.

package com.qpex.examples.quantum_observatory.operators

pub fn build_interferometer_constants() -> Operator {
    Operator InterferometerPhase = Z
    return InterferometerPhase
}

pub fn interference_probe() -> State<Int> {
    state slit = coin()
    state path_a = when (slit) { 0 -> 0, else -> 1 }
    state path_b0 = when (slit) { 0 -> 1, else -> 2 }
    state path_b = phase(path_b0, pi)
    state screen = interfer(path_a, path_b)
    return screen
}
