// CPU-only continuous models: Fock, position-grid, sparse-Pauli, and trace-out.
// Each section owns one carrier representation. Keeping the sections in this
// entry makes the CPU/backend boundary explicit without inventing a second
// language semantics for the QPU lane.

package com.qpex.examples.quantum_observatory.cpu

public fun main() -> Unit {
    // Fock number basis: the oscillator Hamiltonian acts on dirac(0).
    Operator H_osc = N + 0.5
    state psi_osc = dirac(0)
    state psi_osc = evolve psi_osc under H_osc for 0.4
    state viewed_osc = inspect(psi_osc)

    // Position grid: the wavepacket and X/P operators share the grid carrier.
    state psi_grid = wavepacket(-4.0, 4.0, 16, 0.0, inv_sqrt2)
    Operator H_grid = 0.5 * (P * P + X * X)
    state psi_grid = evolve psi_grid under H_grid for 0.2
    state viewed_grid = inspect(psi_grid)

    // Sparse Pauli register: a small Ising-like Hamiltonian.
    Operator H_sparse = -1.0 * (Z(0) * Z(1) + Z(1) * Z(2))
    state sparse_q0 = |+>
    state sparse_q1 = |0>
    state sparse_q2 = |0>
    state (sparse_q0, sparse_q1, sparse_q2) =
        evolve (sparse_q0, sparse_q1, sparse_q2) under H_sparse for 0.1

    // Reduced-subsystem diagnostic: trace the coin before observing the grid.
    State<(Qubit, Position)> (trace_coin, trace_position) = |+> *|* dirac(0)
    state _traced_coin = trace_out(trace_coin)
    snapshot psi_grid to stdout
    measure psi_grid
}
