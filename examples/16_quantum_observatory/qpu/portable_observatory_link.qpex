// Portable QPU lane — the qubit-only Quantum Observatory link.
// The same source runs on cpu and emits vendor-neutral OpenQASM 3.

package com.qpex.examples.quantum_observatory.qpu

pub fn main() -> Unit {
    state observatory = |+>
    state probe = |0>
    state probe = cnot(observatory, probe)
    state correlation = expect(ZZ, observatory, probe)
    state viewed = inspect(correlation)
    measure probe
}
