// B04 — repetition uses `evolve times N`, not classical loops (axiom 4).

package com.staqex.examples.basics.evolve_not_loops

pub fn main() -> Unit {
    state psi = |+>
    state psi = evolve psi under Z for pi / 2.0
    state ez = expect(Z, psi)
    state viewed = inspect(ez)

    measure psi
}
