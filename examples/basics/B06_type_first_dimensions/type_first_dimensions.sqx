// B06 — Type-First quantities carry (L,M,T) dimensions.

package com.qpex.examples.basics.type_first_dimensions

import qpex.math.*

pub fn main() -> Unit {
    Delta<Time> dt = 0.5.s
    Mass m = 1.0.kg
    Stiffness k = 1.0.N_m

    state bit = coin()

    State<Length> x0 = when (bit) {
      0 -> 0.0.m,
      else -> 1.0.m,
    }
    State<Momentum> p0 = when (bit) {
      0 -> 1.0.kg_m_s,
      else -> 0.0.kg_m_s,
    }

    (x, p) = evolve (x0, p0) times 2 {
      (x + (dt / m) * p, p - (dt * k) * x)
    }

    state viewed = inspect(x)
    measure viewed
}
