// B03 — failure is a world-line tag, not an exception (ADR 0025).

package com.staqex.examples.basics.failure_worldline

pub fn main() -> Unit {
    state bit = coin()

    state num = when (bit) {
      0 -> 4.0,
      else -> 8.0,
    }

    state den = when (bit) {
      0 -> 0.0,
      else -> 2.0,
    }

    // Division by zero yields an `Err` label inside the joint — no throw.
    state ratio = num / den

    state viewed = inspect(ratio)
    measure viewed
}
