// B08 — Operator Hamiltonians, site `hop`, and Suzuki evolution policy.

package com.staqex.examples.basics.operators_hamiltonians

pub fn main() -> Unit {
    Float J = 1.0
    Float h = 0.5

    Operator H_chain = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])

    state s0 = |+>
    state s1 = |+>
    state (s0, s1) = evolve (s0, s1) under H_chain for 0.7
        using Suzuki(order = 2, steps = 6)

    state zz = expect(ZZ, s0, s1)
    state viewed = inspect(zz)
    // Terminal measure is singular; uncompute the sibling wire.
    state s1 = |0>
    measure s0
}
