// B09 — multi-file DTQW via module import (ADR 0054).

package examples.basics.multi_file_modules

import examples.basics.multi_file_modules.domain.walk_environment
import examples.basics.multi_file_modules.operators.walk_operators

pub fn main() -> Unit {
    Operator walk_operator = build_coin_operator()

    state c = |0>
    state x = dirac(0)
    state (c, x) = c *|* x

    // Unrolled DTQW steps (coin then conditional shift).
    state c = apply(walk_operator, c)
    state x = walk_shift(c, x)
    state c = apply(walk_operator, c)
    state x = walk_shift(c, x)

    // Module `evolve` + imported step surface (identity step; see operators).
    state (c, x) = evolve (c, x) times n_steps {
        step_quantum_walk(walk_operator, c, x)
    }

    state viewed = inspect(x)
    state c = |0>
    measure viewed
}
