// B07 — namespace / enum / struct / visibility (ADR 0058).
// Geometry packs are struct/enum; Hamiltonian from free-fn + param struct
// (LISS-0297 / LISS-0300). `_pad` is the module-private visibility seat.
// Mutable physical systems with clocks stay `class` elsewhere (A06, QMD, A10).
// WP-0089 / LISS-0289: named struct construction (ADR 0181).

namespace Geometry {
    pub enum Boundary {
        Open,
        Periodic
    }

    pub struct Segment {
        val length: Float
        val bc: Boundary
    }
}

namespace Model {
    // Couplings pack — `_pad` is intentionally not `pub` (visibility demo).
    pub struct IsingParams {
        pub val J: Float
        pub val h: Float
        val _pad: Float
    }
}

pub fn ising_hamiltonian(p: Model.IsingParams) -> Operator {
    return -p.J * (Z[0] * Z[1]) - p.h * (X[0] + X[1])
}

Geometry.Segment seg = Geometry.Segment { length: 2.0, bc: Geometry.Boundary.Open }
Float scale = seg.length

Model.IsingParams params = Model.IsingParams { J: 1.0, h: 0.5, _pad: 0.0 }
Operator H = ising_hamiltonian(params)

state s0 = |+>
state s1 = |+>
state (s0, s1) = evolve (s0, s1) under H for scale * 0.25
    using Suzuki(order = 2, steps = 4)
measure s0 tracing_out s1
