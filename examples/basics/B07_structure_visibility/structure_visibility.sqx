// B07 — namespace / enum / struct / visibility (ADR 0058).
// WP-0088 / LISS-0262: struct/enum for geometry; class only as physical system
// (builds H) — not a mutable enterprise Tracker.

package com.staqex.examples.basics.structure_visibility

namespace Geometry {
    pub enum Boundary {
        Open,
        Periodic
    }

    pub struct Segment {
        val length: Float
        val bc: Boundary
    }
}

namespace Model {
    // Physical system: couplings + Hamiltonian — not a DTO with step counters.
    pub class IsingChain {
        pub val J: Float
        pub val h: Float
        val _pad: Float

        fn init(J: Float, h: Float, _pad: Float) {
            this.J = J
            this.h = h
            this._pad = _pad
        }

        pub fn hamiltonian() -> Operator {
            Float J = this.J
            Float h = this.h
            Operator H = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])
            return H
        }
    }
}

pub fn main() -> Unit {
    Geometry.Segment seg = Geometry.Segment(2.0, Geometry.Boundary.Open)
    Float scale = seg.length

    Model.IsingChain chain = Model.IsingChain(1.0, 0.5, 0.0)
    Operator H = chain.hamiltonian()

    state s0 = |+>
    state s1 = |+>
    state (s0, s1) = evolve (s0, s1) under H for scale * 0.25
        using Suzuki(order = 2, steps = 4)
    measure s0 tracing_out s1
}
