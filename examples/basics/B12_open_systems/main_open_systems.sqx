// staqex-profile: experiment
// B12 — one-qubit Lindblad detector model on the CPU lane.
// staqex-lane: open

Operator H = X

DensityState<Qubit> rho = DensityState(
    RawMatrix([
        [1.0, 0.0],
        [0.0, 0.0]
    ])
)

DensityState<Qubit> observed = lindblad(
    rho,
    H,
    JumpSet([RawMatrix([
        [0.0, 1.0],
        [0.0, 0.0]
    ])]),
    0.1
)

// lindblad leaves the source density live; static uncompute.
state rho = vacuum
measure observed
