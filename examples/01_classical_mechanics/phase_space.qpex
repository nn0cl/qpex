// Classical phase-space ensemble — Euler pushforward (Never Leave the State)
// H = p^2/2 + x^2/2, dt = 0.5
// Initial ensemble: two worlds mixed by coin (uncertain start).

state bit = coin()
state x = when (bit) {
  0 -> 0.0,
  else -> 1.0,
}
state p = when (bit) {
  0 -> 1.0,
  else -> 0.0,
}

// evolve step 1: x' = x + dt*p, p' = p - dt*x
state x1 = when (bit) {
  0 -> 0.5,
  else -> 1.0,
}
state p1 = when (bit) {
  0 -> 1.0,
  else -> -0.5,
}

// evolve step 2
state x2 = when (bit) {
  0 -> 1.0,
  else -> 0.75,
}
state p2 = when (bit) {
  0 -> 0.75,
  else -> -1.0,
}

state viewed = inspect(x2)
measure viewed
