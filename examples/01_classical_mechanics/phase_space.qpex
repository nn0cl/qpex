// Classical phase-space ensemble — Type-First quantities + dimensional Euler
// H = p²/(2m) + ½ k x² ,  (x, p) ↦ (x + (dt/m) p,  p − (dt k) x)

package com.qpex.examples.mechanics

import qpex.math.*

public fun main() {
    Delta<Time> dt = 0.5.s
    Mass        m  = 1.0.kg
    Stiffness   k  = 1.0.N_m

    state bit = coin()

    State<Length> x0 = when (bit) {
      0 -> 0.0.m,
      else -> 1.0.m,
    }
    State<Momentum> p0 = when (bit) {
      0 -> 1.0.kg_m_s,
      else -> 0.0.kg_m_s,
    }

    // Correlated pushforward; `for dt` checks Time dimension (one Euler step × times)
    (x, p) = evolve (x0, p0) times 2 {
      (x + (dt / m) * p, p - (dt * k) * x)
    }

    state viewed = inspect(x)
    measure viewed
}
