// City route search — Grover amplify the congestion-free corridor (toy N=4).
// Dream: smart-city traffic without gridlock. NOT a real metropolitan solver.

package com.qpex.examples.city_route_search

import com.qpex.examples.city_route_search.domain.city_graph
import com.qpex.examples.city_route_search.operators.route_oracle

pub fn main() -> Unit {
    City.Transit.CorridorMap map = City.Transit.CorridorMap(4, 2)
    Float target = 2.0

    // Superposition over corridors 0..3
    state b0 = coin()
    state b1 = coin()
    state route = b0 * 2 + b1

    state round0 = inspect(route)

    // Oracle: phase-flip Express (harvested target index)
    state marked = phase(route, pi, target)
    state amplified = grover_diffuse(marked)

    state round1 = inspect(amplified)
    state viewed_target = inspect(target)
    state viewed_n = inspect(map.n_routes)
    measure amplified
}
