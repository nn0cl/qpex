// Orbital mesh DTQW step — Coin ≈ R_y(π/2), then walk_shift on Position.
// Harvested Operator Coin + fn step_orbital_hop (ADR 0054).

package com.qpex.examples.orbital_mesh_walk.operators

pub fn build_mesh_coin() -> Operator {
    Operator Coin = (X + Z) * inv_sqrt2
    return Coin
}

pub fn step_orbital_hop(operator: Operator, c: State<Qubit>, x: State<Position>) -> State<(Qubit, Position)> {
    State<Qubit> c = apply(operator, c)
    State<Position> x = walk_shift(c, x)
    return c *|* x
}
