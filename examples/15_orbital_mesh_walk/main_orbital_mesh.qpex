// Orbital mesh walk — DTQW on satellite node indices (line mesh stand-in).
// Dream: galaxy-scale relay discovery. NOT orbital mechanics or RF routing.

package com.qpex.examples.orbital_mesh_walk

import com.qpex.examples.orbital_mesh_walk.domain.constellation
import com.qpex.examples.orbital_mesh_walk.operators.mesh_walk

pub fn main() -> Unit {
    Space.Constellation.MeshParams mesh = Space.Constellation.MeshParams(8, 20)
    Operator walk_operator = build_mesh_coin()

    State<Qubit> c = |+>
    State<Position> x = dirac(0)
    State<(Qubit, Position)> (c, x) = c *|* x

    state (c, x) = evolve (c, x) times mesh.n_steps {
        step_orbital_hop(walk_operator, c, x)
    }

    state mx = expect(X, c)
    state viewed_mx = inspect(mx)
    state viewed_x = inspect(x)
    state viewed_n = inspect(mesh.n_nodes)

    measure x
}
