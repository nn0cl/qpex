// Controlled unitaries — capply(ctrl, U, tgt) (ADR 0043)
// cnot ≡ capply(_, X, _); CZ = capply(_, Z, _) phase kick on |11⟩

package com.qpex.examples.quantum_info

pub fn main() -> Unit {
    // Φ⁺ via Hadamard + controlled-X (same as cnot)
    state alice = |0>
    state bob = |0>
    state alice = hadamard(alice)
    state bob = capply(alice, X, bob)

    state zz = expect(ZZ, alice, bob)

    // Fresh pair for CZ: |+⟩⊗|+⟩ → controlled-Z → ⟨ZZ⟩ still +1, relative phase on |11⟩
    state a2 = |+>
    state b2 = |+>
    state b2 = capply(a2, Z, b2)
    state zz2 = expect(ZZ, a2, b2)

    state viewed = inspect(zz)
    measure bob
}
