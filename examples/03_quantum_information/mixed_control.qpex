// Mixed control polarities — ● and ○ on different wires (ADR 0048)
// capply(a, !b, X, t) fires iff a=|1⟩ and b=|0⟩

package com.qpex.examples.quantum_info

public fun main() {
    state a = |1>
    state b = |0>
    state t = |0>
    state t = capply(a, !b, X, t)

    state viewed = inspect(t)
    measure t
}
