// Bell / EPR — Φ⁺ via Hadamard-like prep + CNOT (phase-preserving)
//
// |Φ⁺⟩ = (|00⟩ + |11⟩)/√2  is prepared as:
//   alice = |+⟩, bob = |0⟩, then bob ← CNOT(alice, bob).
// Correlation is read non-destructively as ⟨Z⊗Z⟩ = +1 — not nested `when`.

package com.qpex.examples.quantum_info

public fun main() {
    state alice = |+>
    state bob = |0>

    // CNOT: |c,t⟩ ↦ |c, t⊕c⟩  (coherent; amplitudes untouched)
    state bob = cnot(alice, bob)

    state viewed_pair = inspect(bob)

    // ⟨Z_A ⊗ Z_B⟩ = +1 on Φ⁺ (agreement in Z); does not collapse
    state corr = expect(ZZ, alice, bob)
    state viewed = inspect(corr)

    measure corr
}
