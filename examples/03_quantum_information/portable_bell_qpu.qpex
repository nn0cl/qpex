// Portable Bell Φ⁺ — SAME source for cpu Joint and qpu OpenQASM (ADR 0036)
// Prep: |+⟩⊗|0⟩ then CNOT; ⟨ZZ⟩ via expect (non-destructive); terminal measure on bob.

package com.qpex.examples.quantum_info

public fun main() {
    state alice = |+>
    state bob = |0>
    state bob = cnot(alice, bob)
    state corr = expect(ZZ, alice, bob)
    state viewed = inspect(corr)
    measure bob
}
