// Multi-controlled unitaries — Toffoli / CCX (ADR 0046)
// capply(c0, c1, X, t) ≡ toffoli(c0, c1, t)

package com.qpex.examples.quantum_info

pub fn main() -> Unit {
    // |11⟩|0⟩ ↦ |11⟩|1⟩ under CCX
    state c0 = |1>
    state c1 = |1>
    state t = |0>
    state t = toffoli(c0, c1, t)

    state viewed = inspect(t)
    measure t
}
