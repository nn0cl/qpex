// Double-slit — complex amplitudes + spontaneous path interference
// Paths meet at screen bin 1 with opposite phase → destructive cancel.
//
// slit |0⟩ → path A hits bins {0,1} with phase 0
// slit |1⟩ → path B hits bins {1,2} with phase π

package com.qpex.examples.quantum_basics

pub fn main() -> Unit {
    state slit = coin()

    state screenA = when (slit) {
      0 -> 0,
      else -> 1,
    }

    state screenB0 = when (slit) {
      0 -> 1,
      else -> 2,
    }

    // Path B carries e^{iπ} = −1
    state screenB = phase(screenB0, pi)

    // |A + B|² : shared bin 1 cancels (amp_A + amp_B = 0)
    state screen = interfer(screenA, screenB)

    state viewed = inspect(screen)
    measure viewed
}
