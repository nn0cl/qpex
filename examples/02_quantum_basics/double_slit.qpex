// Double-slit pedagogy — path superposition + interfer on screen bins
// Screen bins: 0=left, 1=center, 2=right
// Path A prefers left/center; path B prefers center/right; interfer peaks at center.

state slit = coin()

state screenA = when (slit) {
  0 -> 0,
  else -> 1,
}
state screenB = when (slit) {
  0 -> 1,
  else -> 2,
}

// Path mixture: both world-lines kept (Never Leave the State)
state path = when (slit) {
  0 -> 0,
  else -> 1,
}

// interfer of the two path→screen maps (Discrete stand-in for |A+B|^2)
state screen = interfer(screenA, screenB)

state viewed = inspect(screen)
measure viewed
