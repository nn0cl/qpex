// Grover search — oracle phase flip + diffusion (N=4, target=2)
// Index as joint pushforward b0*2+b1 (no nested when — NESTED_WHEN_ERROR).
// Equal superposition → mark |2⟩ by e^{iπ} → invert about mean → |2⟩.

package com.qpex.examples.algorithms

public fun main() {
    state b0 = coin()
    state b1 = coin()
    // Computational basis index on H_b0 ⊗ H_b1 — arithmetic on the joint
    state idx = b0 * 2 + b1

    state round0 = inspect(idx)

    // Oracle: phase-flip only the target value 2 (θ → θ+π)
    state marked = phase(idx, pi, 2)

    // Diffusion: c ↦ 2μ − c on the amplitude marginal
    state amplified = grover_diffuse(marked)

    state round1 = inspect(amplified)
    measure amplified
}
