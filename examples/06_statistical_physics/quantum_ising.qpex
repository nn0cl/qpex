// Quantum Ising (N=2) — H = −J Z₀Z₁ − h (X₀ + X₁), U = e^{−iHt}
// Companion to ising_model.qpex (same TFIM; ADR 0053).

package com.qpex.examples.statphys

public fun main() -> Unit {
    Float J = 1.0
    Float h = 0.5

    Operator H_ising = -J * (Z(0) * Z(1)) - h * (X(0) + X(1))

    // Product |+⟩⊗|+⟩ then joint Schrödinger evolve
    state s0 = |+>
    state s1 = |+>
    state (s0, s1) = evolve (s0, s1) under H_ising for 0.7

    // Non-destructive correlator ⟨Z⊗Z⟩ (classical scalar — do not measure)
    state zz = expect(ZZ, s0, s1)
    state viewed = inspect(zz)
    measure s0
}
