// Transverse-field quantum Ising (N=2) — H = −J Z₀Z₁ − h(X₀+X₁), U = e^{−iHt}
// Replaces the classical coin/when/project pedagogy (ADR 0053).

package com.qpex.examples.statphys

pub fn main() -> Unit {
    Float J = 1.0
    Float h = 0.5

    Operator H_tfim = -J * (Z(0) * Z(1)) - h * (X(0) + X(1))

    state s0 = |+>
    state s1 = |+>
    state (s0, s1) = evolve (s0, s1) under H_tfim for 0.7

    state zz = expect(ZZ, s0, s1)
    state viewed = inspect(zz)
    measure s0
}
