// Noether Forge Slice C — static full-candidate entry (self-contained).
// Ownership modules document domain policy; entry stays runnable via run_source.
// Linear reuse: rebind the same state name through evolve (consume-and-replace).

package examples.applied.noether_forge

pub fn main() -> Unit {
    // Finite review spine: plus-state prepare, local Hamiltonian evolve,
    // magnetization observation intent, then terminal measure only.
    state psi = |+>
    Operator H = Z + 0.25 * X
    state psi = evolve psi under H for 0.35
    state magnetization = expect(Z, psi)
    state viewed_m = inspect(magnetization)
    measure psi
}
