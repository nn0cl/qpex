// QAOA portfolio toy — one p=1 layer on a 2-asset QUBO (Ising form).
// NOT a production portfolio optimizer or market simulator.

package com.staqex.examples.applied.qaoa_portfolio

pub fn main() -> Unit {
    Operator H_cost = -0.6 * Z[0] - 0.4 * Z[1] + 0.5 * (Z[0] * Z[1])
    Operator H_mixer = X[0] + X[1]

    state q0 = coin()
    state q1 = coin()

    state (q0, q1) = evolve (q0, q1) under H_mixer for 0.4
    state (q0, q1) = evolve (q0, q1) under H_cost for 0.3

    state zz = expect(ZZ, q0, q1)
    state viewed = inspect(zz)

    measure q0
}
