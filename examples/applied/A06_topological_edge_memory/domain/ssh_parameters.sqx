// SSH system — struct params + free pure scores; class only for mutable clock.
// LISS-0296: pure Float scores as free fns (mut step stays on SSHSystem).

package examples.applied.topological_edge_memory.domain

namespace Topology.SSH {
    pub struct SSHParams {
        val v_intra: Float
        val w_inter: Float
    }

    // True system seat: private clock advances under open-boundary narrative.
    pub class SSHSystem {
        var _t: Float = 0.0
        pub val params: Topology.SSH.SSHParams
        pub val bc: Topology.BoundaryCondition

        fn init(p: Topology.SSH.SSHParams, boundary: Topology.BoundaryCondition) {
            this.params = p
            this.bc = boundary
        }

        pub fn step() -> Float {
            this._t = this._t + 0.1
            Float done = 1.0
            return done
        }
    }
}

pub fn topological_index() -> Float {
    return 1.0
}

pub fn band_gap(p: Topology.SSH.SSHParams) -> Float {
    Float gap = p.w_inter - p.v_intra
    return gap + gap
}
