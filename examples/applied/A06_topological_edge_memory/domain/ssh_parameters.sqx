// SSH system — struct params (immutable) + class system (`fn init`, `_` clock)

package com.staqex.examples.applied.topological_edge_memory.domain

namespace Topology.SSH {
    pub struct SSHParams {
        val v_intra: Float
        val w_inter: Float
    }

    pub class SSHSystem {
        var _t: Float = 0.0
        pub val params: Topology.SSH.SSHParams
        pub val bc: Topology.BoundaryCondition

        fn init(p: Topology.SSH.SSHParams, boundary: Topology.BoundaryCondition) {
            this.params = p
            this.bc = boundary
        }

        pub fn step() -> Float {
            this._t = this._t + 0.1
            Float done = 1.0
            return done
        }

        pub fn topological_index() -> Float {
            Float winding = 1.0
            return winding
        }

        pub fn band_gap() -> Float {
            Float gap = this.params.w_inter - this.params.v_intra
            Float gap2 = gap + gap
            return gap2
        }
    }
}
