// SSH edge-state evolution — multi-file OOP + hop Schrödinger evolve
// Left-edge |0⟩ under topological SSH (w>v, open BC); occupation(·) is non-destructive.

package com.staqex.examples.applied.topological_edge_memory

import com.staqex.examples.applied.topological_edge_memory.domain.topology
import com.staqex.examples.applied.topological_edge_memory.domain.ssh_parameters
import com.staqex.examples.applied.topological_edge_memory.operators.hamiltonian_builder

pub fn main() -> Unit {
    Topology.BoundaryCondition bc = Topology.BoundaryCondition.Open
    Topology.ChainLattice lat = Topology.ChainLattice(3, Topology.BoundaryCondition.Open)

    Topology.SSH.SSHParams p = Topology.SSH.SSHParams(0.5, 1.5)
    Topology.SSH.SSHSystem sys = Topology.SSH.SSHSystem(p, Topology.BoundaryCondition.Open)
    Float stepped = sys.step()
    Float winding = sys.topological_index()
    Float gap = sys.band_gap()

    Operator Hssh = build_ssh_hamiltonian()
    State<Position> psi = dirac(0)

    state psi = evolve psi under Hssh for 0.5

    Float left = occupation(psi, 0)
    Float right = occupation(psi, 5)
    state viewed_left = inspect(left)
    state viewed_right = inspect(right)
    // Do not inspect `psi` before terminal measure (inspect would consume).

    measure psi
}
