// SSH edge-state evolution — multi-file structure + hop Schrödinger evolve.
// Left-edge |0⟩ under topological SSH (w>v, open BC); occupation(·) is non-destructive.
// WP-0089 / LISS-0278: no inspect museum; selective import short names (ADR 0177).
// Multi-file keeps package (not experiment-profile single-file).

package examples.applied.topological_edge_memory

import examples.applied.topological_edge_memory.domain.topology.{BoundaryCondition, ChainLattice}
import examples.applied.topological_edge_memory.domain.ssh_parameters
import examples.applied.topological_edge_memory.operators.hamiltonian_builder

pub fn main() -> Unit {
    BoundaryCondition bc = BoundaryCondition.Open
    ChainLattice lat = ChainLattice(3, BoundaryCondition.Open)

    Topology.SSH.SSHParams p = Topology.SSH.SSHParams(0.5, 1.5)
    Topology.SSH.SSHSystem sys = Topology.SSH.SSHSystem(p, BoundaryCondition.Open)
    Float stepped = sys.step()
    Float winding = sys.topological_index()
    Float gap = sys.band_gap()

    Operator Hssh = build_ssh_hamiltonian()
    State<Position> psi = dirac(0)

    state psi = evolve psi under Hssh for 0.5

    // Notebook quantities (Host may log); not inspect floods before measure.
    Float left = occupation(psi, 0)
    Float right = occupation(psi, 5)

    measure psi
}
