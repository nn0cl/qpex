// DTQW step on a configuration graph — Coin ≈ R_y(π/2), then walk_shift.

package com.qpex.examples.applied.robot_graph_planner.operators

pub fn build_graph_coin() -> Operator {
    Operator Coin = (X + Z) * inv_sqrt2
    return Coin
}

pub fn step_graph_hop(operator: Operator, c: State<Qubit>, x: State<Position>) -> State<(Qubit, Position)> {
    State<Qubit> c = apply(operator, c)
    State<Position> x = walk_shift(c, x)
    return c *|* x
}
