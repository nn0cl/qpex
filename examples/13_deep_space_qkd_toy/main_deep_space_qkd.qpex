// Deep-space QKD toy — Bell / EPR link Earth station ↔ craft.
// Dream: untappable command link. NOT a real BB84/E91 stack or Mars modem.
// Eavesdropping story: any mid-link measure destroys the Φ⁺ correlation.

package com.qpex.examples.deep_space_qkd_toy

import com.qpex.examples.deep_space_qkd_toy.domain.link_parties
import com.qpex.examples.deep_space_qkd_toy.operators.bell_channel

public fun main() -> Unit {
    Space.Link.OpticalHop hop = Space.Link.OpticalHop(0, 1)

    Float ideal_zz = 1.0

    // Φ⁺ prep: |+⟩_A ⊗ |0⟩_B → CNOT → (|00⟩+|11⟩)/√2
    state alice = |+>
    state bob = |0>
    state bob = cnot(alice, bob)

    state viewed_pair = inspect(bob)

    // Untapped link witness ⟨Z⊗Z⟩ = +1 (non-destructive expect)
    state corr = expect(ZZ, alice, bob)
    state viewed_corr = inspect(corr)
    state viewed_ideal = inspect(ideal_zz)
    state viewed_hop = inspect(hop.alice_station)

    measure bob
}
