// U(1) gauge pedagogy — local complex phase must not change occupation measure
// Gauge: attach e^{iα} via `phase`; physical observable = site occupation.

package com.qpex.examples.qft

public fun main() {
    state site = coin()

    state phys0 = map(site, v -> v)
    state before = inspect(phys0)

    // Local U(1) phase α = π on occupied site (complex amp; not classical label)
    state gauged = phase(site, 3.141592653589793)

    state phys1 = map(gauged, v -> v)
    state invariant = project(phys1, v -> v >= 0)
    state after = inspect(invariant)

    measure invariant
}
